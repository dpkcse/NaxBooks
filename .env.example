APP_NAME="NAXAS Accounting"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://naxas.test
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_VERSION=0.1.0
CENTRAL_DOMAIN=naxas.test
ADMIN_DOMAIN=admin.naxas.test
TENANT_ROOT_DOMAIN={tenant}.naxas.test
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=naxas_central
DB_USERNAME=
DB_PASSWORD=
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@naxas.test"
MAIL_FROM_NAME="${APP_NAME}"
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
